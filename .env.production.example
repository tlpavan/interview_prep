# Production environment configuration
# Copy this file to .env.production and fill in the values

# Server
PORT=5000
NODE_ENV=production

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: if using OpenAI for anything
OPENAI_API_KEY=your_openai_api_key_here
# Optional: VAPI for voice calls
VAPI_API_KEY=your_vapi_api_key_here

# Database (MongoDB)
# Format: mongodb://username:password@host:port/database?authSource=admin
DATABASE_URL=mongodb://admin:password@mongodb:27017/interviewprep?authSource=admin

# CORS (comma-separated origins, no spaces)
# Example: CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com
# Required in production; do not use *
CORS_ORIGIN=https://yourdomain.com

# Email configuration (optional - for sending notification emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# EMAIL_FROM=noreply@yourdomain.com

# Firebase (for authentication - configure in frontend Firebase config)
# These are NOT used in backend; they belong in the frontend Firebase config
# But if you have a service account for admin operations, add:
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
